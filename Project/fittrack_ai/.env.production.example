SPRING_DATASOURCE_URL=jdbc:postgresql://<AIVEN_HOST>:<AIVEN_PORT>/<AIVEN_DATABASE>?sslmode=require
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=change_this_password

JWT_SECRET=change_this_to_a_very_long_secure_random_secret_key
SPRING_PROFILES_ACTIVE=prod
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_DAYS=30
ADMIN_EMAILS=admin@company.com
GEMINI_API_KEY=replace_with_a_new_server_side_key
GEMINI_MODEL=gemini-3.6-flash
ASSISTANT_REQUESTS_PER_MINUTE=6
KEEP_ALIVE_ENABLED=false
INTERNAL_SCHEDULER_ENABLED=false
JOB_SECRET=replace_with_a_random_job_secret
SWAGGER_ENABLED=false
MEDIA_PROVIDER=cloudinary
MEDIA_ALLOWED_HOSTS=res.cloudinary.com
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app

VITE_API_URL=/api
VITE_API_MODE=proxy
